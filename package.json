{
  "name": "opencode-m365-copilot",
  "version": "2.1.2",
  "description": "Use your org's Microsoft 365 Copilot as the model backend for opencode",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opencode-m365": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./proxy": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    }
  },
  "main": "./dist/plugin.mjs",
  "types": "./dist/plugin.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.1",
    "otpauth": "^9.6.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "playwright": "^1.65.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "microsoft-365",
    "copilot",
    "m365",
    "openai-compatible",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/opencode-copilot-plugin.git"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.2"
  }
}
